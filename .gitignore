/target
*.orig

# Extracted game assets and anything derived from the user's own install.
# Never commit game data.
/extracted
/assets-cache
*.GPK
*.gpk
*.ors
*.ORS
*.wmv
*.WMV

# Cargo.lock is intentionally NOT ignored. It is the pin that makes the
# dependency policy in docs/DEPENDENCIES.md real. Do not add it here.

# Release archives and the vendored SDL3/ffmpeg builds land under /target, which
# is already ignored above. The submodule *sources* in third_party/ are tracked
# by git as submodules and must not be listed here.

# The devcontainer's mount configuration: paths to the user's own installs.
# .devcontainer/.env.example is the tracked half.
*.env

# What Gradle and an Android IDE write into android/ when they run without
# tools/build-android.sh's --project-cache-dir (an IDE sync, a bare `gradle`):
# per-project caches, the SDK path, project files. The script's own output
# all lands under /target.
/android/.gradle
/android/.kotlin
/android/.idea
/android/local.properties
/android/**/*.iml
/android/**/.cxx
