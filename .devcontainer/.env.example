# Copy to .env (beside this file) and point these at your own installs.
#
# This project ships no game data. Everything it does is derived at runtime from
# an install you already own -- the archive key from SCHOOLDAYS HQ.exe, the UI
# widget tables from SysMenuSDHQ.dll -- so a container with nothing mounted can
# build the engine and cannot verify one line of it.
#
# docker-compose.yml reads this file. A variable left unset falls back to an
# empty directory, so the container still comes up and `daysengine` reports no
# install; nothing is silently half-configured.
#
# .env is gitignored. Do not commit paths from your own machine.

# The School Days HQ install: the directory holding the game executable and
# Packs/. Mounted at /game/schooldays.
DAYS_GAME_DIR=/home/you/Games/School Days HQ

# The Shiny Days install, if you have one. Mounted at /game/shinydays.
# Shiny Days is a second title, not a variant: the formats transfer, the screens
# are their own recovery.
DAYS_SHINYDAYS_DIR=/home/you/Games/Shiny Days

# Your Ghidra project, if you already have one -- the directory holding the
# imported SCHOOLDAYS HQ.exe and SysMenuSDHQ.dll. Mounted at /root/ghidra_projects
# ($GHIDRA_PROJ in the container). Leave it unset and the container keeps its own
# project on a volume instead, which survives rebuilds; either way the project is
# never in the repository, because it holds your game files.
#DAYS_GHIDRA_PROJECT_DIR=/home/you/ghidra_projects

# rw (the default) or ro. Playing writes saves into the install, so rw is what
# the game itself needs; ro is for verifying against an install that must not be
# touched -- point DAYS_GAME_DIR at a copy and you get both.
DAYS_MOUNT_MODE=rw

# Only set these if the desktop sockets are somewhere other than the default.
# docker-compose.yml already falls back to $XDG_RUNTIME_DIR from the environment
# VS Code was started in, and to /run/user/1000 and wayland-0 when that is empty.
#XDG_RUNTIME_DIR=/run/user/1000
#WAYLAND_DISPLAY=wayland-0
